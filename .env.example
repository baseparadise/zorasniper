# ============================================================
# Zora Sniper — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- REQUIRED -----

# Alchemy RPC URL for Base network (use WSS for WebSocket events)
# Get one at https://alchemy.com → Create App → Base Mainnet
ALCHEMY_RPC_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of your trading wallet (with 0x prefix)
# ⚠️  NEVER share this or commit it to git
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----- OPTIONAL -----

# Basescan API key for enhanced tx lookup
# Get one at https://basescan.org/apis
BASESCAN_API_KEY=

# Zora API key
ZORA_API_KEY=

# GMGN API key (for token analytics)
GMGN_API_KEY=

# CoinGecko API key (for price data)
COINGECKO_API_KEY=

# Zerion API key (for portfolio tracking)
ZERION_API_KEY=

# Override the Zora Coins factory address on Base (optional)
# Default: 0x777777722D078c97c6ad07d9f36801e653E356B9
ZORA_FACTORY_ADDRESS=

# Session secret for signed cookies
SESSION_SECRET=change_me_to_a_random_string

# App environment
NODE_ENV=production
